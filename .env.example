# Required in production so canonical, sitemap, robots, and structured-data URLs
# use the public domain. Include the protocol and omit a trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.customboxifypro.com

# Optional: override the default Google Search Console verification token.
GOOGLE_SITE_VERIFICATION=

# Optional: use "countdown" for the launch countdown page. Defaults to "home".
NEXT_PUBLIC_MARKETING_PAGE_MODE=home
